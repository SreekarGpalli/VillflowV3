{
  "productName": "VillFlow",
  "version": "0.1.0",
  "identifier": "com.villflow.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "VillFlow",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      },
      {
        "title": "Scratchpad",
        "width": 450,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "visible": false,
        "label": "scratchpad",
        "url": "scratchpad.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
